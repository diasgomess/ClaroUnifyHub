# ==========================================
# ClaroUnify Hub - Git Ignore
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

*.pem
*.key
*.crt

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# SQLite files específicos
database/*.db
data/*.db
data/*.sqlite
data/*.sqlite3

# ---------- Logs ----------
*.log
logs/

# ---------- Tests / Coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---------- IDE / Editors ----------
.vscode/
.idea/
*.swp
*.swo
*.swn

# VS Code - permitir configurações compartilháveis
!.vscode/extensions.json
!.vscode/settings.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Node / Frontend ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build
dist/
build/
.next/
.nuxt/
.cache/

# ---------- Ollama / IA ----------
# Não versionar modelos locais
models/
ollama/
*.gguf

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Temporary files ----------
tmp/
temp/
*.tmp
*.temp

# ---------- Uploads ----------
uploads/
*.upload

# ---------- Generated files ----------
generated/
output/
outputs/

# ---------- Personal / Local data ----------
local/
.local/
secrets/
credentials/

# ---------- Backup ----------
*.bak
*.backup
*.old

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Windows ----------
$RECYCLE.BIN/
*.lnk