# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# --- LLM (Qwen3 via Ollama) -------------------------------------------------
# Se USE_LLM=false, o sistema usa direto o classificador por palavras-chave
# (útil para rodar sem GPU/sem Ollama instalado, ex.: em CI ou Docker sem LLM).
USE_LLM=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_S=20

# Opcional — encaminha todo handoff também via webhook (ex.: Zendesk/Salesforce),
# além da fila interna. Deixe vazio para usar só a fila interna.
HANDOFF_WEBHOOK_URL=

# --- Banco de dados ----------------------------------------------------------
# Caminho do arquivo SQLite. No Docker, aponta para o volume montado.
DATABASE_PATH=./clarounify.db

# --- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Regras de negócio (ajustáveis sem tocar no código) ---------------------
DEFAULT_CUSTOMER=11999990001
RATE_LIMIT_MAX_MSGS=20
RATE_LIMIT_WINDOW_S=60

# Limiares de alerta automático do dashboard (RNF006)
ALERT_VOLUME_HANDOFF_PCT_MAX=40.0
ALERT_TAXA_RESOLUCAO_PCT_MIN=50.0
ALERT_RATE_LIMIT_BLOQUEIOS_MAX=3

# Custos estimados usados só para ilustrar o cálculo de custo/atendimento
# no dashboard (não são custos reais da Claro).
CUSTO_BOT_ESTIMADO=0.15
CUSTO_HANDOFF_ESTIMADO=8.50
